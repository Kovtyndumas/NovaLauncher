{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nova Rust",
  "version": "3.0.0-beta.10",
  "identifier": "dev.ktvx.nova.rust",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Nova Rust",
        "width": 1100,
        "height": 700,
        "minWidth": 900,
        "minHeight": 600,
        "visible": false,
        "backgroundColor": "#08090b",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self' data: blob:; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; connect-src 'self' ipc: http://ipc.localhost https:; font-src 'self' data:; object-src 'none'; frame-src 'none'",
      "capabilities": [
        {
          "identifier": "main-window",
          "windows": [
            "main"
          ],
          "permissions": [
            "core:default",
            "core:window:allow-start-dragging"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Game",
    "shortDescription": "Nova Minecraft Launcher",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    }
  }
}
